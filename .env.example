# Base HTTPS URL of the WooCommerce storefront. Do not append /wp-json.
WOO_BASE_URL=https://shop.example.com

# WooCommerce → Settings → Advanced → REST API
WOO_CONSUMER_KEY=ck_replace_me
WOO_CONSUMER_SECRET=cs_replace_me

# Optional HTTP timeout for each WooCommerce request.
WOO_TIMEOUT_SECONDS=30

# Optional retry policy for read-only GET and OPTIONS requests. Mutations are never retried.
WOO_READ_RETRY_ATTEMPTS=3
WOO_READ_RETRY_BACKOFF_SECONDS=0.5
